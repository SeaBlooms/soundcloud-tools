# SoundCloud OAuth app credentials
SOUNDCLOUD_CLIENT_ID=your_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_client_secret_here

# Your SoundCloud profile username (e.g. vanishaudio)
SOUNDCLOUD_USER_PERMALINK=your_username_here

# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: comma-separated genre pool for tag generation
# SOUNDCLOUD_STYLE_POOL=downtempo,IDM,ambient,lo-fi house

# Optional: gear/software for description generation
# DESCRIPTION_GEAR=Ableton Live, Hardware synths, Hardware drum machines

# Optional: vibe keywords for description generation
# DESCRIPTION_VIBE=Melancholic & introspective, Hypnotic & repetitive, Gritty & raw, Bright & euphoric

# Google Drive folder ID (for upload pipeline — from the folder URL)
# GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
